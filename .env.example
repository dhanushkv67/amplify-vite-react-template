# Copy to .env; replace this example-only password before exposing any service.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-local-password
WEB_PORT=8080

# Explicit opt-in; demo accounts must never be enabled on an internet-facing stack.
DEMO_SEED=false
# Set a private password of at least 12 characters if DEMO_SEED=true.
DEMO_PASSWORD=
